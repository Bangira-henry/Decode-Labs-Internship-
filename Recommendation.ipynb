# Step 1: Our Database of items
items = {
    "AI & Tech": ["Learn Python for AI", "Master Machine Learning", "Build ChatGPT Clone", "Data Science Bootcamp"],
    "Movies": ["The Matrix", "Interstellar", "Avengers: Endgame", "Inception"],
    "Books": ["Atomic Habits", "Deep Learning Book", "Rich Dad Poor Dad", "The Alchemist"],
    "Music": ["Afro Beats Mix", "Malawi Gospel Hits", "Hip Hop Classics", "Chill Lofi"],
    "Sports": ["Football Training Plan", "Gym Workout Guide", "Basketball Tricks"]
}

# Step 2: Recommendation Logic Function
def recommend_system(user_interest):
    user_interest = user_interest.lower()
    
    for category, item_list in items.items():
        if user_interest in category.lower() or user_interest in category.lower().split():
            return category, item_list
    
    # Pattern matching logic - check keywords
    if "code" in user_interest or "python" in user_interest or "ai" in user_interest:
        return "AI & Tech", items["AI & Tech"]
    elif "movie" in user_interest or "film" in user_interest:
        return "Movies", items["Movies"]
    elif "book" in user_interest or "read" in user_interest:
        return "Books", items["Books"]
    elif "music" in user_interest or "song" in user_interest:
        return "Music", items["Music"]
    elif "sport" in user_interest or "football" in user_interest or "gym" in user_interest:
        return "Sports", items["Sports"]
    else:
        return None, None

# Step 3: Take User Input
print("=== AI Recommendation Engine ===")
print("Available categories: AI & Tech, Movies, Books, Music, Sports")
user_input = input("Enter your interest (e.g., AI, Movies, Books): ")

category, recommendations = recommend_system(user_input)

# Step 4: Display Recommended Items
if recommendations:
    print(f"\n✅ Based on your interest '{user_input}', we recommend from {category}:")
    for i, rec in enumerate(recommendations, 1):
        print(f"{i}. {rec}")
else:
    print(f"\n❌ Sorry, no match for '{user_input}'. Try: AI, Movies, Books, Music, Sports")

print("\n--- Project 3 Complete - Logic Building Successful ---")